# Copy to .env and fill in your values

# Supabase — Session Pooler URL (port 5432, asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Supabase — Direct URL (port 5432, psycopg2 driver) used by Alembic
DATABASE_URL_SYNC=postgresql+psycopg2://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Supabase — from Project Settings → API
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Exchange rates (optional — falls back to 1:1)
EXCHANGE_RATE_API_KEY=

# Resend (optional — needed for reminder emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=TripLedger <noreply@yourdomain.com>

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://yourdomain.vercel.app

ENVIRONMENT=production
